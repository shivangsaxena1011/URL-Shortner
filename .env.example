# PostgreSQL Database URL (Compatible with Neon, Supabase, AWS RDS, Docker, or Local PostgreSQL)
# Example for Neon: postgresql://neondb_owner:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkshortener?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret-string-at-least-32-chars"

# Public URL used to form short links (e.g. https://your-project.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Redis URL for distributed rate limiting
# REDIS_URL="redis://localhost:6379"
